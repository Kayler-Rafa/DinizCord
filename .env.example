# ---------------------------------------------------------------------------
# Banco de dados (PostgreSQL) — obrigatório
# ---------------------------------------------------------------------------
# Com o docker-compose local:
DATABASE_URL="postgresql://dinizcord:dinizcord@localhost:5432/dinizcord?schema=public"

# ---------------------------------------------------------------------------
# Autenticação — obrigatório
# ---------------------------------------------------------------------------
# Segredo usado para assinar os tickets JWT do WebSocket e derivar hashes de
# sessão. Gere com: openssl rand -base64 48
# NUNCA versione o valor real.
AUTH_SECRET=""

# ---------------------------------------------------------------------------
# URLs públicas — obrigatório
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Endereço do gateway WebSocket (processo separado, ver README > Arquitetura).
NEXT_PUBLIC_WS_URL="ws://localhost:3001"

# ---------------------------------------------------------------------------
# Gateway WebSocket
# ---------------------------------------------------------------------------
WS_PORT="3001"
# Origens autorizadas a abrir WebSocket, separadas por vírgula.
WS_ALLOWED_ORIGINS="http://localhost:3000"

# ---------------------------------------------------------------------------
# WebRTC — STUN é obrigatório, TURN é opcional (mas recomendado)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_STUN_SERVER="stun:stun.l.google.com:19302"
# Sem TURN, usuários atrás de NAT simétrico não conseguem estabelecer P2P.
TURN_SERVER_URL=""
TURN_USERNAME=""
TURN_PASSWORD=""

# ---------------------------------------------------------------------------
# Observabilidade
# ---------------------------------------------------------------------------
LOG_LEVEL="info"

# ---------------------------------------------------------------------------
# Cadastro
# ---------------------------------------------------------------------------
# Quando "true", só é possível criar conta através de um link de convite válido.
REGISTRATION_INVITE_ONLY="false"
